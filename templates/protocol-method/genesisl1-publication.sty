% --------------------------------------------------------------------------
% Official brand asset
% --------------------------------------------------------------------------
% Keep the official SVG as the editable master. For LaTeX, export it as a
% tightly cropped PDF and place it at assets/genesisl1-lockup-navy.pdf.
\newcommand{\GLLogoFile}{assets/genesisl1-lockup-navy.pdf}
\NewDocumentCommand{\GenesisLogoFile}{m}{\renewcommand{\GLLogoFile}{#1}}
\newcommand{\GenesisLogo}[1][7mm]{%
  \IfFileExists{\GLLogoFile}{%
    \raisebox{-0.18\height}{\includegraphics[height=#1,keepaspectratio]{\GLLogoFile}}%
  }{%
    {\sffamily\bfseries\color{GenesisNavy}GenesisL1}%
  }%
}

